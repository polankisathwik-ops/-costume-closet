{
  "info": {
    "name": "CostumeCloset Theatre API",
    "description": "Full test collection for the CostumeCloset Theatre API.\n\nRun the whole collection in order with the Collection Runner. The requests create their own test data, verify the three required twist tests (201 pending, 200 approved, 400 Invalid status change), then clean up.\n\nbaseUrl defaults to http://localhost:3000. Start the server with `npm start` before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Add Actor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actors"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Actor\",\n  \"email\": \"postman.actor@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "pm.test('returns the new actor', function () { pm.expect(data.name).to.eql('Postman Actor'); });",
                  "pm.collectionVariables.set('actorId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Costume",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/costumes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "costumes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Gown\",\n  \"era\": \"Renaissance\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "pm.test('returns name and era', function () {\n  pm.expect(data.name).to.eql('Postman Gown');\n  pm.expect(data.era).to.eql('Renaissance');\n});",
                  "pm.collectionVariables.set('costumeId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Second Costume",
          "request": {
            "method": "POST",
