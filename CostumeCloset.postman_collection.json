              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Armor\",\n  \"era\": \"Medieval\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
