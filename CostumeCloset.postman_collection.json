                  "var data = pm.response.json();",
                  "pm.test('every result matches the era', function () {\n  pm.expect(data).to.be.an('array');\n  pm.expect(data.length).to.be.above(0);\n  data.forEach(function (costume) {\n    pm.expect(costume.era.toLowerCase()).to.eql('renaissance');\n  });\n});"
